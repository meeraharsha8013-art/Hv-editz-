<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>HV EDITZ</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #050505;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #080808;
    border-bottom: 2px solid #ffae00;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    background: linear-gradient(90deg,#ffe600,#ff8500,#ff2020);
    -webkit-background-clip: text;
    color: transparent;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 18px;
}

.hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: radial-gradient(circle,#251000,#050505 70%);
    padding: 25px;
}

.logo-circle {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 3px solid #ffae00;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 0 20px #ffae00, 0 0 45px #ff4500;
    overflow: hidden;
}

.logo-circle img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

h1 {
    margin-top: 30px;
    font-size: 48px;
    background: linear-gradient(90deg,#ffe600,#ff8500,#ff2020);
    -webkit-background-clip: text;
    color: transparent;
}

.hero p {
    margin: 20px;
    letter-spacing: 5px;
    color: #ddd;
}

.btn {
    display: inline-block;
    padding: 14px 30px;
    background: linear-gradient(90deg,#ffe600,#ff8500,#ff2020);
    color: black;
    text-decoration: none;
    font-weight: bold;
    border-radius: 30px;
}

section:not(.hero) {
    padding: 70px 8%;
    text-align: center;
}

.title {
    color: #ffbd00;
    font-size: 35px;
    margin-bottom: 35px;
}

.services {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
    gap: 20px;
}

.card {
    background: #111;
    border: 1px solid #ff8500;
    border-radius: 15px;
    padding: 35px 20px;
}

.card h3 {
    color: #ffbd00;
    margin-bottom: 15px;
}

.card p {
    color: #aaa;
    line-height: 1.7;
}

.about {
    background: #101010;
}

.about p {
    color: #bbb;
    line-height: 2;
    max-width: 700px;
    margin: auto;
}

.contact p {
    color: #bbb;
    margin-bottom: 25px;
}

footer {
    text-align: center;
    padding: 25px;
    border-top: 1px solid #ffae00;
    color: #aaa;
}

@media(max-width:600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 5px;
        font-size: 12px;
    }

    .logo-circle {
        width: 250px;
        height: 250px;
    }

    h1 {
        font-size: 38px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">HV EDITZ</div>
    <nav>
        <a href="#home">Home</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero" id="home">

    <div class="logo-circle">
        <img src="./Hv-editz.png" alt="HV EDITZ Logo">
    </div>

    <h1>HV EDITZ</h1>
    <p>DREAM • EDIT • CREATE</p>

    <a href="#services" class="btn">EXPLORE NOW</a>

</section>

<section id="services">
    <h2 class="title">OUR SERVICES</h2>

    <div class="services">
        <div class="card">
            <h3>VIDEO EDITING</h3>
            <p>Creative cinematic video editing.</p>
        </div>

        <div class="card">
            <h3>PHOTO EDITING</h3>
            <p>Professional photo editing.</p>
        </div>

        <div class="card">
            <h3>VFX</h3>
            <p>Creative visual effects.</p>
        </div>

        <div class="card">
            <h3>POSTER DESIGN</h3>
            <p>Unique creative poster designs.</p>
        </div>
    </div>
</section>

<section class="about" id="about">
    <h2 class="title">ABOUT HV EDITZ</h2>
    <p>
        Welcome to HV EDITZ.
        Dream Big. Edit Creatively.
        Create Something Amazing.
    </p>
</section>

<section class="contact" id="contact">
    <h2 class="title">LET'S CONNECT</h2>
    <p>Let's create something amazing together!</p>
    <a href="mailto:yourmail@gmail.com" class="btn">CONTACT US</a>
</section>

<footer>
    © 2026 HV EDITZ | DREAM • EDIT • CREATE
</footer>

</body>
</html>
