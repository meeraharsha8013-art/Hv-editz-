<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>HV EDITZ | Official Website</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
background:#050505;
color:white;
font-family:Arial,sans-serif;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:22px 8%;
background:#080808;
border-bottom:1px solid #ff9500;
}

.logo{
font-size:28px;
font-weight:bold;
background:linear-gradient(90deg,#fff000,#ff9500,#ff2020);
-webkit-background-clip:text;
color:transparent;
}

nav a{
color:white;
text-decoration:none;
margin-left:20px;
font-size:14px;
}

nav a:hover{
color:#ffbd00;
}

.hero{
min-height:90vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:25px;
background:radial-gradient(circle,#301400,#050505 70%);
}

.logo-img{
width:280px;
height:280px;
object-fit:contain;
margin-bottom:25px;
filter:drop-shadow(0 0 15px #ff9900);
}

.hero h1{
font-size:55px;
background:linear-gradient(90deg,#fff000,#ff9500,#ff2020);
-webkit-background-clip:text;
color:transparent;
}

.hero p{
color:#ddd;
letter-spacing:5px;
margin:20px 0 35px;
}

.btn{
display:inline-block;
padding:15px 35px;
border-radius:30px;
background:linear-gradient(90deg,#ffe600,#ff8500,#ff2020);
color:black;
text-decoration:none;
font-weight:bold;
}

section{
padding:80px 8%;
text-align:center;
}

.title{
font-size:36px;
color:#ffbd00;
margin-bottom:40px;
}

.services{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
}

.card{
background:#111;
padding:40px 20px;
border:1px solid #a64b00;
border-radius:15px;
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
border-color:#ffe600;
box-shadow:0 0 20px #ff950044;
}

.card h3{
color:#ffbd00;
margin-bottom:15px;
}

.card p{
color:#aaa;
line-height:1.7;
}

.about{
background:#101010;
}

.about p{
max-width:700px;
margin:auto;
color:#bbb;
line-height:2;
}

.contact p{
color:#bbb;
margin-bottom:25px;
}

footer{
padding:25px;
text-align:center;
background:#080808;
border-top:1px solid #ff9500;
color:#aaa;
}

footer span{
color:#ffbd00;
}

@media(max-width:600px){
header{
flex-direction:column;
gap:18px;
}

nav a{
margin:0 7px;
font-size:12px;
}

.logo-img{
width:230px;
height:230px;
}

.hero h1{
font-size:40px;
}
}
</style>
</head>

